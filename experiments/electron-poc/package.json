{
  "name": "ecompilot-electron-poc",
  "version": "0.0.1",
  "private": true,
  "description": "Isolated Electron POC for loading the local EcomPilot Next.js app.",
  "type": "module",
  "main": "main.mjs",
  "scripts": {
    "dev": "node scripts/run-managed-poc.mjs",
    "attach": "electron .",
    "smoke": "node scripts/run-managed-smoke.mjs",
    "smoke:static": "node scripts/smoke-check.mjs",
    "electron:smoke": "node scripts/electron-smoke.mjs"
  },
  "devDependencies": {
    "electron": "^39.2.6"
  }
}
